      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "EXnS942x3zXjSVeW",
          "name": "HubSpotAuth"
        }
      },
      "onError": "continueErrorOutput"
